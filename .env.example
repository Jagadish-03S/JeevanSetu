# ====================================================================
# JEEVANSETU Environment Configuration Template
# Copy to .env and adjust variables for your deployment environment
# ====================================================================

# Backend Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=jeevansetu-secure-pilot-secret-2026-change-in-prod

# Database Configuration (PostgreSQL / Supabase / Railway)
# If left empty, backend runs with in-memory seeded store for instant local testing
DATABASE_URL=postgresql://postgres:password@localhost:5432/jeevansetu

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Emergency Contact Overrides
EMERGENCY_NATIONAL_PHONE=112
EMERGENCY_AMBULANCE_PHONE=108
EMERGENCY_KARNATAKA_AROGYAVANI=104

